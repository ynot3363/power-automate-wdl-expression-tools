{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Extension Integration Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/out/test/extension/runTest.js",
      "console": "integratedTerminal",
      "preLaunchTask": "npm: build"
    }
  ]
}
