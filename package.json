{
  "name": "power-automate-wdl-expression-tools",
  "displayName": "Power Automate WDL Expression Tools",
  "description": "Edit and validate Microsoft Power Automate WDL expressions in Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "aepcodes",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ynot3363/power-automate-wdl-expression-tools.git"
  },
  "bugs": {
    "url": "https://github.com/ynot3363/power-automate-wdl-expression-tools/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "title": "Power Automate WDL Expressions",
      "properties": {
        "powerAutomateWdlExpressions.format.indentSize": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "scope": "resource",
          "description": "Number of spaces used for each WDL expression indentation level."
        },
        "powerAutomateWdlExpressions.format.useTabs": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Use tabs instead of spaces when formatting WDL expressions."
        },
        "powerAutomateWdlExpressions.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable syntax and static semantic diagnostics for WDL expression documents."
        }
      }
    },
    "commands": [
      {
        "command": "powerAutomateWdlExpressions.newExpression",
        "title": "Power Automate: New WDL Expression"
      },
      {
        "command": "powerAutomateWdlExpressions.formatExpression",
        "title": "Power Automate: Format WDL Expression",
        "enablement": "editorLangId == power-automate-wdl-expression"
      },
      {
        "command": "powerAutomateWdlExpressions.minifyExpression",
        "title": "Power Automate: Minify WDL Expression",
        "enablement": "editorLangId == power-automate-wdl-expression"
      }
    ],
    "languages": [
      {
        "id": "power-automate-wdl-expression",
        "aliases": [
          "Power Automate WDL Expression"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".wdlexpr"
        ]
      }
    ],
    "grammars": [
      {
        "language": "power-automate-wdl-expression",
        "scopeName": "source.power-automate-wdl-expression",
        "path": "./syntaxes/power-automate-wdl-expression.tmLanguage.json"
      }
    ]
  },
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:extension && npm run build:tests",
    "build:extension": "esbuild src/extension/extension.ts --bundle --external:vscode --format=cjs --platform=node --target=node20 --outfile=dist/extension.js",
    "build:tests": "tsc --project tsconfig.test.json",
    "corpus:update": "npm run corpus:update:parser && npm run corpus:update:analyzer && npm run formatter:update",
    "corpus:update:analyzer": "tsx scripts/updateAnalyzerGoldens.ts",
    "corpus:update:parser": "tsx scripts/updateExpressionGoldens.ts",
    "formatter:update": "tsx scripts/updateFormatterGoldens.ts",
    "inspect:ast": "tsx scripts/printAst.ts",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:integration": "npm run build && node out/test/extension/runTest.js",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.0.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
